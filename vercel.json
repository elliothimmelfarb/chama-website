{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": [
    "cdg1"
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.chamainteligente.com"
        }
      ],
      "destination": "https://chamainteligente.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.chamainteligente.com"
        }
      ],
      "destination": "https://chamainteligente.com/:path*",
      "permanent": true
    },
    {
      "source": "/built",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/built.html",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/clients",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/clients.html",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/simple",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/simple.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/simple/coaching",
      "destination": "/coaching",
      "permanent": false
    },
    {
      "source": "/simple/coaching.html",
      "destination": "/coaching",
      "permanent": false
    },
    {
      "source": "/simple/built",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/simple/built.html",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/simple/clients",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/simple/clients.html",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/simple/about",
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/simple/about.html",
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/simple/work",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/simple/work.html",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/simple/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/worlds",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/worlds.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/worlds/coaching",
      "destination": "/coaching",
      "permanent": true
    },
    {
      "source": "/worlds/about",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/training",
      "destination": "/coaching",
      "permanent": true
    },
    {
      "source": "/training.html",
      "destination": "/coaching",
      "permanent": true
    },
    {
      "source": "/elliot-rozalie.webp",
      "destination": "/assets/elliot-rozalie.webp",
      "permanent": true
    },
    {
      "source": "/about-family.jpg",
      "destination": "/assets/about-family.jpg",
      "permanent": true
    },
    {
      "source": "/hearth-public",
      "destination": "/hearth",
      "permanent": false
    },
    {
      "source": "/hearth/:path+",
      "destination": "https://hearth.chamainteligente.com/:path+",
      "permanent": true
    },
    {
      "source": "/hearth-room",
      "destination": "https://hearth.chamainteligente.com/",
      "permanent": true
    },
    {
      "source": "/api/hearth/:path+",
      "destination": "https://hearth.chamainteligente.com/api/hearth/:path+",
      "permanent": true
    },
    {
      "source": "/api/oauth/:path+",
      "destination": "https://hearth.chamainteligente.com/api/oauth/:path+",
      "permanent": true
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://hearth.chamainteligente.com/.well-known/oauth-authorization-server",
      "permanent": true
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://hearth.chamainteligente.com/.well-known/oauth-protected-resource",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/intake-cleanup",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/watchdog",
      "schedule": "5,35 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/docs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css)",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": {
            "inc": [
              "05f5fba254",
              "064282a1ac",
              "71a9be7ec3",
              "8a1815a2a7",
              "af9b097cd8",
              "b376c3bce2",
              "c5b567bda6",
              "c7149b7fa3",
              "d7080de293",
              "e001488e88"
            ]
          }
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css)",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": {
            "ninc": [
              "05f5fba254",
              "064282a1ac",
              "71a9be7ec3",
              "8a1815a2a7",
              "af9b097cd8",
              "b376c3bce2",
              "c5b567bda6",
              "c7149b7fa3",
              "d7080de293",
              "e001488e88"
            ]
          }
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css)",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|svg|ico|webp|jpg|jpeg|gif|woff2|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml|llms\\.txt|llms-full\\.txt|a8ed69a1919a0c783461e70964a8bddc1b33c190c6a1858f89978e4676e7cd94\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; img-src 'self' data:; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; img-src 'self' data:; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/hearth",
      "destination": "/hearth-public"
    },
    {
      "source": "/mcp",
      "destination": "https://hearth.chamainteligente.com/mcp"
    },
    {
      "source": "/feed",
      "destination": "https://hearth.chamainteligente.com/api/feed"
    },
    {
      "source": "/feed.xml",
      "destination": "https://hearth.chamainteligente.com/api/feed?format=xml"
    },
    {
      "source": "/feed/:slug",
      "destination": "https://hearth.chamainteligente.com/api/feed?path=:slug"
    }
  ]
}
