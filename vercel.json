{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": [
    "cdg1"
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.chamainteligente.com"
        }
      ],
      "destination": "https://chamainteligente.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.chamainteligente.com"
        }
      ],
      "destination": "https://chamainteligente.com/:path*",
      "permanent": true
    },
    {
      "source": "/worlds",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/worlds.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/worlds/coaching",
      "destination": "/coaching",
      "permanent": true
    },
    {
      "source": "/worlds/about",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/clients",
      "permanent": true
    },
    {
      "source": "/work.html",
      "destination": "/clients",
      "permanent": true
    },
    {
      "source": "/simple/work",
      "destination": "/simple/clients",
      "permanent": true
    },
    {
      "source": "/simple/work.html",
      "destination": "/simple/clients",
      "permanent": true
    },
    {
      "source": "/training",
      "destination": "/coaching",
      "permanent": true
    },
    {
      "source": "/training.html",
      "destination": "/coaching",
      "permanent": true
    },
    {
      "source": "/elliot-rozalie.webp",
      "destination": "/assets/elliot-rozalie.webp",
      "permanent": true
    },
    {
      "source": "/about-family.jpg",
      "destination": "/assets/about-family.jpg",
      "permanent": true
    },
    {
      "source": "/hearth-public",
      "destination": "/hearth",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/intake-cleanup",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/watchdog",
      "schedule": "5,35 * * * *"
    },
    {
      "path": "/api/hearth-cron",
      "schedule": "20 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/docs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/mcp",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css)",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": {
            "inc": [
              "0423b5bedc",
              "08fe2359ca",
              "0e13151137",
              "1bd12af0fb",
              "26e453412d",
              "33b3a125d0",
              "3d04623906",
              "4304adc11d",
              "45b94ec90f",
              "5e57dbd6ed",
              "71a9be7ec3",
              "752d48d2a5",
              "97e60958b4",
              "9c81e0061b",
              "a592622ad0",
              "a7704ae7ed",
              "b23504649b",
              "b5f18f0e6c",
              "b73e6c4eed",
              "b889f167b2",
              "dc632ba6b4",
              "e001488e88",
              "f4e5d0f475",
              "fe17b7f65c"
            ]
          }
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css)",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": {
            "ninc": [
              "0423b5bedc",
              "08fe2359ca",
              "0e13151137",
              "1bd12af0fb",
              "26e453412d",
              "33b3a125d0",
              "3d04623906",
              "4304adc11d",
              "45b94ec90f",
              "5e57dbd6ed",
              "71a9be7ec3",
              "752d48d2a5",
              "97e60958b4",
              "9c81e0061b",
              "a592622ad0",
              "a7704ae7ed",
              "b23504649b",
              "b5f18f0e6c",
              "b73e6c4eed",
              "b889f167b2",
              "dc632ba6b4",
              "e001488e88",
              "f4e5d0f475",
              "fe17b7f65c"
            ]
          }
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css)",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|svg|ico|webp|jpg|jpeg|gif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml|llms\\.txt|llms-full\\.txt|a8ed69a1919a0c783461e70964a8bddc1b33c190c6a1858f89978e4676e7cd94\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; img-src 'self' data:; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; img-src 'self' data:; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/hearth",
      "has": [
        {
          "type": "cookie",
          "key": "__Host-chama_hearth"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; connect-src 'self' https://accounts.google.com https://api.stripe.com; frame-src https://accounts.google.com https://js.stripe.com https://hooks.stripe.com; img-src 'self' data: https://lh3.googleusercontent.com https://avatars.githubusercontent.com https://cdn.discordapp.com; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/hearth",
      "missing": [
        {
          "type": "cookie",
          "key": "__Host-chama_hearth"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/hearth/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; connect-src 'self' https://accounts.google.com https://api.stripe.com; frame-src https://accounts.google.com https://js.stripe.com https://hooks.stripe.com; img-src 'self' data: https://lh3.googleusercontent.com https://avatars.githubusercontent.com https://cdn.discordapp.com; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/hearth-room",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; connect-src 'self' https://accounts.google.com https://api.stripe.com; frame-src https://accounts.google.com https://js.stripe.com https://hooks.stripe.com; img-src 'self' data: https://lh3.googleusercontent.com https://avatars.githubusercontent.com https://cdn.discordapp.com; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/hearth",
      "has": [
        {
          "type": "cookie",
          "key": "__Host-chama_hearth"
        }
      ],
      "destination": "/hearth-room"
    },
    {
      "source": "/hearth",
      "destination": "/hearth-public"
    },
    {
      "source": "/hearth/:path*",
      "destination": "/hearth-room"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/feed",
      "destination": "/api/feed"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed?format=xml"
    },
    {
      "source": "/feed/:slug",
      "destination": "/api/feed?path=:slug"
    },
    {
      "source": "/api/hearth/:path*",
      "destination": "/api/hearth"
    },
    {
      "source": "/api/oauth/:path*",
      "destination": "/api/oauth"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth"
    }
  ]
}
