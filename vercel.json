{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": [
    "cdg1"
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.chamainteligente.com"
        }
      ],
      "destination": "https://chamainteligente.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.chamainteligente.com"
        }
      ],
      "destination": "https://chamainteligente.com/:path*",
      "permanent": true
    },
    {
      "source": "/elliot-rozalie.webp",
      "destination": "/assets/elliot-rozalie.webp",
      "permanent": true
    },
    {
      "source": "/about-family.jpg",
      "destination": "/assets/about-family.jpg",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/intake-cleanup",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/watchdog",
      "schedule": "5,35 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|svg|ico|webp|jpg|jpeg|gif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml|llms\\.txt|llms-full\\.txt|a8ed69a1919a0c783461e70964a8bddc1b33c190c6a1858f89978e4676e7cd94\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ]
}
